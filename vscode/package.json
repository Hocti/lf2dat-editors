{
  "name": "lf2-data",
  "displayName": "LF2 Data",
  "description": "把舊版 Little Fighter 2 的 .dat 解密成文字開啟",
  "version": "0.1.0",
  "publisher": "hocti",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "lf2-data",
        "aliases": ["LF2 Data"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lf2-data",
        "scopeName": "source.lf2-data",
        "path": "./syntaxes/lf2-data.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "lf2.dat",
        "displayName": "LF2 Data",
        "selector": [{ "filenamePattern": "*.dat", "scheme": "file" }],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "lf2.openDat",
        "title": "LF2: Open Data as Text",
        "category": "LF2"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "lf2.openDat",
          "when": "resourceExtname == .dat",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "lf2.openDat",
          "when": "activeCustomEditorId == 'lf2.dat'",
          "group": "navigation"
        }
      ]
    }
  }
}
